{
  "name": "fastify-rest-api",
  "type": "module",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint .",
    "start": "fastify start -l info app.js",
    "dev": "fastify start -w -l info -P app.js",
    "lint:fix": "oxfmt . && oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexlet-components/fastify-rest-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hexlet-components/fastify-rest-api/issues"
  },
  "homepage": "https://github.com/hexlet-components/fastify-rest-api#readme",
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@fastify/autoload": "^6.5.0",
    "@fastify/sensible": "^6.0.6",
    "fastify": "^5.12.5",
    "fastify-cli": "^8.0.2",
    "fastify-plugin": "^6.0.0"
  },
  "engines": {
    "node": ">=26.0"
  },
  "devDependencies": {
    "fastify-swagger": "^5.2.0",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
