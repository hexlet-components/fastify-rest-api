{
  "name": "fastify-rest-api",
  "type": "module",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint --config=.oxlintrc.json .",
    "start": "fastify start -l info app.js",
    "dev": "fastify start -w -l info -P app.js",
    "lint:fix": "oxfmt --ignore-path=.oxfmtignore . && oxlint --config=.oxlintrc.json --fix .",
    "format": "oxfmt --ignore-path=.oxfmtignore .",
    "format:check": "oxfmt --ignore-path=.oxfmtignore --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexlet-components/fastify-rest-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hexlet-components/fastify-rest-api/issues"
  },
  "simple-git-hooks": {
    "pre-push": "npx biome check ."
  },
  "homepage": "https://github.com/hexlet-components/fastify-rest-api#readme",
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@fastify/autoload": "^6.5.0",
    "@fastify/sensible": "^6.0.4",
    "fastify": "^5.10.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^6.0.0"
  },
  "engines": {
    "node": ">=26.0"
  },
  "devDependencies": {
    "fastify-swagger": "^5.2.0",
    "npm-check-updates": "^23.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
