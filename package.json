{
  "name": "fastify-rest-api",
  "type": "module",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint .",
    "start": "fastify start -l info app.js",
    "dev": "fastify start -w -l info -P app.js",
    "lint:fix": "oxfmt . && oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexlet-components/fastify-rest-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hexlet-components/fastify-rest-api/issues"
  },
  "homepage": "https://github.com/hexlet-components/fastify-rest-api#readme",
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@fastify/autoload": "^6.5.1",
    "@fastify/sensible": "^6.0.7",
    "fastify": "^5.12.7",
    "fastify-cli": "^8.0.3",
    "fastify-plugin": "^6.0.1"
  },
  "engines": {
    "node": ">=26.0"
  },
  "devDependencies": {
    "fastify-swagger": "^5.2.0",
    "npm-check-updates": "^23.1.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.6.0"
}
